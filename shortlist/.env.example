# URL of the Job-Search-App backend (no trailing slash)
VITE_API_URL=http://localhost:3000

# Google OAuth Web client ID (same value as CLIENT_ID in the backend .env).
# Leave empty to hide the "Continue with Google" button.
# Add http://localhost:5173 to "Authorised JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
